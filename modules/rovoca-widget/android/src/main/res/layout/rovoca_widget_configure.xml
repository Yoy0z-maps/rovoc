<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/rovoca_widget_card_background"
  android:orientation="vertical"
  android:paddingStart="20dp"
  android:paddingTop="20dp"
  android:paddingEnd="21.5dp"
  android:paddingBottom="13.5dp">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/rovoca_widget_configure_title"
    android:textColor="@color/rovoca_widget_ink"
    android:textSize="20sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="@string/rovoca_widget_configure_message"
    android:textColor="@color/rovoca_widget_gray"
    android:textSize="13sp" />

  <!-- 단어장이 많으면 이 부분만 스크롤된다 -->
  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1"
    android:fadeScrollbars="true">

    <LinearLayout
      android:id="@+id/configure_options"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingBottom="4dp" />
  </ScrollView>

  <TextView
    android:id="@+id/configure_no_wordbooks"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="@string/rovoca_widget_no_wordbooks"
    android:textColor="@color/rovoca_widget_gray"
    android:textSize="12sp"
    android:visibility="gone" />

  <TextView
    android:id="@+id/configure_cancel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end"
    android:layout_marginTop="8dp"
    android:background="?android:attr/selectableItemBackground"
    android:padding="10dp"
    android:text="@string/rovoca_widget_cancel"
    android:textColor="@color/rovoca_widget_blue"
    android:textSize="15sp"
    android:textStyle="bold" />
</LinearLayout>
