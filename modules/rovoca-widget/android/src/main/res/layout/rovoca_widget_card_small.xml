<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 단어 카드 (2칸) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/rovoca_widget_card_background_wrong">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="15.5dp"
    android:paddingBottom="13.5dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/widget_source_icon"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:importantForAccessibility="no"
        android:src="@drawable/rovoca_widget_ic_wrong_note"
        android:tint="@color/rovoca_widget_red" />

      <TextView
        android:id="@+id/widget_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/rovoca_widget_wrong_note"
        android:textColor="@color/rovoca_widget_gray"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/widget_word"
      android:layout_width="match_parent"
      android:layout_height="30dp"
      android:autoSizeMaxTextSize="24sp"
      android:autoSizeMinTextSize="14sp"
      android:autoSizeTextType="uniform"
      android:gravity="center_vertical"
      android:maxLines="1"
      android:text="@string/rovoca_widget_sample_word"
      android:textColor="@color/rovoca_widget_ink"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_empty_message"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="3"
      android:textColor="@color/rovoca_widget_gray"
      android:textSize="11sp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/widget_part"
      style="@style/RovocaWidgetPartChip"
      android:layout_marginTop="4dp"
      android:text="@string/rovoca_widget_sample_part" />

    <LinearLayout
      android:id="@+id/widget_meaning_box"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:orientation="vertical">

      <TextView
        android:id="@+id/widget_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/rovoca_widget_sample_meaning"
        android:textColor="@color/rovoca_widget_gray"
        android:textSize="13sp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
